          "alias": "zen2cool-blocks/components",
          "_isSecondary": true,
          "typeCompatible": "type",
          "_styles": {
            ".progress-container": {
              "z-index": "20000",
              "position": "fixed",
              "width": "100%",
              "height": "(@LineHeight * 1px)",
              "background": "@BckColor",
              "top": "(@TopLine * 1px)"
            },
            ".progress-bar": {
              "height": "(@LineHeight * 1px)",
              "background": "@Linecolor",
              "width": "0%"
            },
            "& when (@Stickyzen2 = false)": {
              ".sticky2": {
                "position": "fixed",
                "top": "0px",
                "width": "100%"
              }
            },
            "& when (@Stickyzen2)": {
              ".sticky2": {
                "position": "fixed",
                "top": "(@TopLine2 * 1px)",
                "width": "100%"
              }
            },
            ".hidden": {
              "display": "none"
            },
            "H10": {
              "color": "#767676"
            }
